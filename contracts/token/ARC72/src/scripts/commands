# deploy
# node main.js deploy -t vns-registrar -n vns-registrar
node main.js deploy
## update reverse registrar
# node main.js reverse update --apid 797610 
## register new node
# node main.js reverse register --apid 797610 --owner BRB3JP4LIW5Q755FJCGVAOA4W3THJ7BR3K6F26EVCGMETLEAZOQRHHJNLQ --duration 0 --papid 780596 --debug 
## set reverse registrar root node
# node main.js reverse set-root-node --apid 797610 --root-node addr.reverse --simulate --debug
## get registrar owner of node
# node main.js arc72 owner-of --apid 797610 --name BRB3JP4LIW5Q755FJCGVAOA4W3THJ7BR3K6F26EVCGMETLEAZOQRHHJNLQ.addr.reverse
# node main.js arc72 owner-of --apid 797610 --name BRB3JP4LIW5Q755FJCGVAOA4W3THJ7BR3K6F26EVCGMETLEAZOQRHHJNLQ.reverse
# node main.js arc72 owner-of --apid 797607 --name nshell.voi
## get name
# node main.js resolver get-name --apid 797608 --node BRB3JP4LIW5Q755FJCGVAOA4W3THJ7BR3K6F26EVCGMETLEAZOQRHHJNLQ.addr.reverse
# node main.js resolver get-name --apid 797608 --node G3MSA75OZEJTCCENOJDLDJK7UD7E2K5DNC7FVHCNOV7E3I4DTXTOWDUIFQ.addr.reverse
## set name
# node main.js resolver set-name --apid 797608 --node BRB3JP4LIW5Q755FJCGVAOA4W3THJ7BR3K6F26EVCGMETLEAZOQRHHJNLQ.addr.reverse --name shelly.voi --debug
### registrar
# npx tsc
# node main.js vns ownerOf --apid 797607 --node nshell.voi
##############################################################
#### how to create subname
# 1. deploy registrar
# node main.js deploy -t vns-registrar -n vns-registrar-founder.voi # 45291944
# 2. setup
# 2.0 set owner in registry
# node main.js vns set-owner --apid 797607 --node founder.voi --owner JLP2X7HEH3AJZ7IXE7AHNC2QAXG3PKUQMXZFGHTO4V3Y5EKFGIWC6BETTA
# node main.js registrar get-app-id --apid 797607 --name founder.voi # 45291944
# 2.1 set registry
# node main.js registrar set-registry --apid 45291944 --registry 797607
# 2.2 set root node
# node main.js registrar set-root-node --apid 45291944 --root-node founder.voi
# 2.3 set payment token 
# node main.js registrar set-payment-token --apid 45291944 --payment-token 302222
# 3. mint and verify
# 3.1 mint
## node main.js registrar mint --apid 45291944 --to BRB3JP4LIW5Q755FJCGVAOA4W3THJ7BR3K6F26EVCGMETLEAZOQRHHJNLQ --name shelly
# 3.1 mint
# node main.js registrar owner-of --apid 45291944 --name shelly.founder.voi
# 4. reclaim (optional)
# node main.js vns owner-of --apid 797607 --node shelly.founder.voi # AAAAA...
# node main.js registrar reclaim --apid 45291944 --name shelly
# node main.js vns owner-of --apid 797607 --node shelly.founder.voi # BRB...
# 5. use resolver
# 5.1 set text value
# node main.js resolver set-text --apid 797608 --node shelly.founder.voi --key msg --value "hello world"
# 5.2 get text value
# node main.js resolver get-text --apid 797608 --node shelly.founder.voi --key msg 

